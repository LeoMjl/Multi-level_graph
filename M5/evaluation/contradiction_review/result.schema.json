{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5 long-range contradiction re-audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "anonymous_id", "reviewer_model", "reasoning_effort",
    "items", "excluded_candidates", "review_notes"
  ],
  "properties": {
    "schema_version": {"const": "m5-contradiction"},
    "anonymous_id": {"type": "string", "pattern": "^E0[1-6]$"},
    "reviewer_model": {"const": "gpt-5.6-sol"},
    "reasoning_effort": {"const": "medium"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "excluded_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/excluded"}
    },
    "review_notes": {"type": "string"}
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "quote", "assertion_status"],
      "properties": {
        "chapter_id": {"type": "integer", "minimum": 1, "maximum": 320},
        "quote": {"type": "string", "minLength": 2, "maxLength": 160},
        "assertion_status": {
          "enum": ["narrator_fact", "observed_fact", "verified_record"]
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_key", "hook_id", "predicate_ids", "category", "entity",
        "attribute", "source_value", "target_value", "source", "target",
        "conflict_reason", "intervening_explanation_checked", "confidence"
      ],
      "properties": {
        "conflict_key": {"type": "string", "pattern": "^H(0[1-9]|10)\\|[^|]+\\|[^|]+$"},
        "hook_id": {"type": "string", "pattern": "^H(0[1-9]|10)$"},
        "predicate_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^H(0[1-9]|10)\\.(seed|state)\\.[0-9]{2}$"}
        },
        "category": {"enum": ["person", "item", "time", "space", "world_rule", "causal"]},
        "entity": {"type": "string", "minLength": 1},
        "attribute": {"type": "string", "minLength": 1},
        "source_value": {"type": "string", "minLength": 1},
        "target_value": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/anchor"},
        "target": {"$ref": "#/$defs/anchor"},
        "conflict_reason": {"type": "string", "minLength": 1},
        "intervening_explanation_checked": {"const": true},
        "confidence": {"type": "number", "minimum": 0.8, "maximum": 1}
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_id", "candidate", "reason"],
      "properties": {
        "hook_id": {"type": "string", "pattern": "^H(0[1-9]|10)$"},
        "candidate": {"type": "string", "minLength": 1},
        "reason": {
          "enum": [
            "omission", "different_entity", "different_time", "justified_update",
            "unverified_claim", "corrected_record", "gold_only", "insufficient_anchors",
            "duplicate", "low_confidence"
          ]
        }
      }
    }
  }
}
